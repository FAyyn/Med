\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Dataset Evaluation}{13}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Comparative analysis of hallucination phenomena across different training paradigms in energy-carbon question answering. Systematic evaluation reveals that baseline models generate factually incorrect responses and miss critical domain-specific details when handling specialized terminology and policy requirements. Our assessment framework employs semantic completeness analysis and factual accuracy validation to quantify answer quality, demonstrating that EC-LLM effectively suppresses hallucinations through domain-specific adaptation while maintaining comprehensive coverage of energy-carbon knowledge.}}{14}{figure.3}\protected@file@percent }
\newlabel{fig:results}{{3}{14}{Comparative analysis of hallucination phenomena across different training paradigms in energy-carbon question answering. Systematic evaluation reveals that baseline models generate factually incorrect responses and miss critical domain-specific details when handling specialized terminology and policy requirements. Our assessment framework employs semantic completeness analysis and factual accuracy validation to quantify answer quality, demonstrating that EC-LLM effectively suppresses hallucinations through domain-specific adaptation while maintaining comprehensive coverage of energy-carbon knowledge}{figure.3}{}}
\newlabel{fig:results@cref}{{[figure][3][]3}{[1][13][]14}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Results and Analysis}{14}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Scaling law analysis revealing optimal training data size for domain-specific model performance. This systematic evaluation quantifies the relationship between dataset scale and model effectiveness, identifying the performance saturation point and providing evidence-based guidance for resource allocation in domain adaptation projects.}}{15}{table.5}\protected@file@percent }
\newlabel{tab:final_comprehensive_eval_en}{{5}{15}{Scaling law analysis revealing optimal training data size for domain-specific model performance. This systematic evaluation quantifies the relationship between dataset scale and model effectiveness, identifying the performance saturation point and providing evidence-based guidance for resource allocation in domain adaptation projects}{table.5}{}}
\newlabel{tab:final_comprehensive_eval_en@cref}{{[table][5][]5}{[1][13][]15}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Qualitative error analysis framework for validating model performance in domain-specific scenarios. This comparative assessment demonstrates how structured LLM-based evaluation identifies critical performance gaps, providing actionable insights for model improvement through detailed analysis of semantic completeness, factual accuracy, and answer similarity across different application domains.}}{16}{table.6}\protected@file@percent }
\newlabel{tab:answer_comparison_revised}{{6}{16}{Qualitative error analysis framework for validating model performance in domain-specific scenarios. This comparative assessment demonstrates how structured LLM-based evaluation identifies critical performance gaps, providing actionable insights for model improvement through detailed analysis of semantic completeness, factual accuracy, and answer similarity across different application domains}{table.6}{}}
\newlabel{tab:answer_comparison_revised@cref}{{[table][6][]6}{[1][13][]16}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Quantitative performance benchmarking across different training paradigms using objective lexical metrics. This systematic comparison provides empirical evidence that the combination of supervised fine-tuning and knowledge distillation achieves optimal domain adaptation, establishing a performance baseline for energy-carbon question answering tasks.}}{17}{table.7}\protected@file@percent }
\newlabel{tab:ecqa_results}{{7}{17}{Quantitative performance benchmarking across different training paradigms using objective lexical metrics. This systematic comparison provides empirical evidence that the combination of supervised fine-tuning and knowledge distillation achieves optimal domain adaptation, establishing a performance baseline for energy-carbon question answering tasks}{table.7}{}}
